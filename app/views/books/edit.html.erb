<h1>Editing Book</h1>
<% if @book.errors.any? %>
  <div class='error_box'>
    <div class='error_box_header'>
      <%= @book.errors.count %> errors prohibited this book from behind saved:
    </div>
    <div class='error_box_body'>
      <ul>
        <% @book.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  </div>
<% end %>

<%= form_with model: @book do |f| %>
  <div>
    <%= f.label :title, 'Title' %><br>
    <%= f.text_field :title %>
  </div>
  <div>
    <%= f.label :body, 'Body' %><br>
    <%= f.text_field :body %>
  </div>
  <%= f.submit 'Update Book' %>
<% end %>

<nav>
  <a><%= link_to 'Show', book_path(@book) %></a>
   | 
  <a><%= link_to 'Back', '/books' %></a>
</nav>