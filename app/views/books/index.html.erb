<h1>Books</h1>
<% if @books.present? %>
  <table>
    <thead>
      <tr><th>Title</th><th>Body</th><th colspan="3"></th></tr>
    </thead>
    <tbody>
      <% @books.each do |book| %>
        <tr>
          <td><%= book.title %></td>
          <td><%= book.body %></td>
          <td><%= link_to 'Show', book_path(book) %></td>
          <td><%= link_to 'Edit', edit_book_path(book) %></td>
          <td><%= link_to 'Destroy', book_path(book), data: {turbo_method: :delete, turbo_confirm: 'Are you sure?'} %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No books found.</p>
<% end %>

<h2>New book</h2>
<% if @book.errors.any? %>
  <div class='error_box'> 
    <div class='error_box_header'>
      <%= @book.errors.count %> errors prohibited this book from being saved:
    </div>
    <div class='error_box_body'>
      <ul>
        <% @book.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  </div>
<% end %>

<%= form_with model: @book do |f| %>
  <div class='field'>
    <div class='field_with_errors'>
      <%= f.label :title, 'Title' %><br>
    </div>
    <div class='field_with_errors'>
      <%= f.text_field :title %>
    </div>
  </div>
  <div class='field'>
    <div class='field_with_errors'>
      <%= f.label :body, 'Body' %><br>
    </div>
    <div class='field_with_errors'>
      <%= f.text_area :body %>
    </div>
  </div>

  <%= f.submit 'Create Book' %>
<% end %>